# ==========================================================
# Nexaa Link Shortener - Environment Variables
# ==========================================================

# Domain branding yang digunakan untuk link pendek
BRAND_DOMAIN=nexaa.my.id

# Port untuk development lokal
PORT=3001

# ==========================================================
# SUPABASE CONFIGURATION (Penyimpanan Cloud Permanen)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# ==========================================================
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================================
# FIREBASE AUTHENTICATION (Login Google)
# Dapatkan dari: Firebase Console -> Project Settings -> General -> Web Apps
# ==========================================================
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456
